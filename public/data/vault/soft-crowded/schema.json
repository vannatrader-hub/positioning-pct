{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vannatrader-hub.github.io/positioning-pct/data/vault/soft-crowded/schema.json",
  "title": "Soft ↔ Crowded weekly pack",
  "description": "One week of the Vault Soft ↔ Crowded pack: sector buckets on the Soft ↔ Crowded scale, the six batch-1 charts frozen at the pack week, a one-page read, and a short article on each chart. Build the Desk parts with `npm run pack:build -- YYYY-MM-DD`; write the read and the articles by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sku",
    "product",
    "week",
    "weekLabel",
    "isoWeek",
    "title",
    "asOf",
    "asOfLabel",
    "house",
    "houseLabel",
    "windowWeeks",
    "basis",
    "sectorSource",
    "read",
    "buckets",
    "unprinted",
    "charts"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "sku": {
      "const": "soft-crowded"
    },
    "product": {
      "const": "SKU1"
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "weekLabel": {
      "type": "string",
      "minLength": 1
    },
    "isoWeek": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$",
      "description": "ISO 8601 week of the pack Friday."
    },
    "title": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2} Soft ↔ Crowded$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T05:00:00[+-]\\d{2}:\\d{2}$",
      "description": "The Friday desk day open, 5:00 AM America/Chicago."
    },
    "asOfLabel": {
      "type": "string",
      "minLength": 1,
      "x-banned-sources": true
    },
    "house": {
      "enum": [
        "jpm",
        "ms",
        "gs",
        "boa",
        "desk"
      ]
    },
    "houseLabel": {
      "type": "string",
      "minLength": 1
    },
    "windowWeeks": {
      "const": 4
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "sectorSource": {
      "type": "string",
      "minLength": 1
    },
    "read": {
      "$ref": "#/$defs/read"
    },
    "buckets": {
      "description": "Sector buckets on the Soft ↔ Crowded scale, extreme soft through crowded.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/bucket"
      }
    },
    "unprinted": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unprinted"
      }
    },
    "charts": {
      "$ref": "#/$defs/chartBatch"
    }
  },
  "$defs": {
    "read": {
      "description": "One-page read for the week: what softened, what crowded, the credit and vol backdrop, and three things to watch next week. 400 to 600 words across every field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kicker",
        "headline",
        "lede",
        "stance",
        "softened",
        "crowded",
        "backdrop",
        "moved",
        "watch",
        "nextWeek"
      ],
      "properties": {
        "kicker": {
          "type": "string",
          "minLength": 1,
          "x-banned-sources": true
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "x-banned-sources": true
        },
        "lede": {
          "type": "string",
          "minLength": 1,
          "x-banned-sources": true
        },
        "stance": {
          "type": "string",
          "minLength": 1,
          "x-banned-sources": true
        },
        "softened": {
          "type": "string",
          "minWords": 40,
          "maxWords": 120,
          "description": "What softened this week.",
          "x-banned-sources": true
        },
        "crowded": {
          "type": "string",
          "minWords": 40,
          "maxWords": 120,
          "description": "What crowded this week.",
          "x-banned-sources": true
        },
        "backdrop": {
          "type": "string",
          "minWords": 40,
          "maxWords": 120,
          "description": "Credit and vol backdrop.",
          "x-banned-sources": true
        },
        "moved": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nextWeek": {
          "description": "Three things to watch next week.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "x-banned-sources": true
          }
        }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "title",
        "range",
        "tone",
        "sectors"
      ],
      "properties": {
        "level": {
          "enum": [
            "extreme soft",
            "soft",
            "mid",
            "crowded"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "xsoft",
            "soft",
            "mid",
            "crowded"
          ]
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sector"
          }
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "short",
        "name",
        "points",
        "display",
        "ile",
        "pill",
        "caption",
        "wowText",
        "regime",
        "level"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^XL[A-Z0-9]+$"
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "display": {
          "type": "string",
          "pattern": "^0\\.\\d{2}$"
        },
        "ile": {
          "type": "string",
          "minLength": 1
        },
        "pill": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "wowText": {
          "type": "string",
          "minLength": 1
        },
        "regime": {
          "enum": [
            "Soft",
            "Mid",
            "Crowded"
          ]
        },
        "level": {
          "enum": [
            "extreme soft",
            "soft",
            "mid",
            "crowded"
          ]
        }
      }
    },
    "unprinted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "short",
        "name",
        "note"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "article": {
      "description": "Short considered article for one Batch-1 chart. The week read stays the overview. Bank labels only; banned source names fail validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "bodyMarkdown",
        "bias",
        "dumbMoney",
        "smartMoney",
        "invalidation"
      ],
      "properties": {
        "headline": {
          "description": "At most 12 words, one line.",
          "type": "string",
          "minLength": 1,
          "maxWords": 12,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "bodyMarkdown": {
          "description": "120 to 220 words. Paragraphs separated by a blank line.",
          "type": "string",
          "minLength": 1,
          "minWords": 120,
          "maxWords": 220,
          "x-banned-sources": true
        },
        "bias": {
          "enum": [
            "long",
            "short",
            "neutral",
            "fade-long",
            "fade-short"
          ]
        },
        "dumbMoney": {
          "description": "One line on the dumb-money cohort: hedge funds, macro funds, mutual funds, CTAs.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "smartMoney": {
          "description": "One line on the smart-money cohort: sharpies, dealers, commercials.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "invalidation": {
          "description": "One line. The print that kills the bias.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        }
      }
    },
    "chartBatch": {
      "description": "Batch-1 charts, frozen at the pack week. Each ref carries a snapshot of that chart's Desk series cut at the pack week, and that chart's article.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch",
        "refs"
      ],
      "properties": {
        "batch": {
          "const": 1
        },
        "refs": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/chartRef"
          }
        }
      }
    },
    "chartRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nav",
        "title",
        "house",
        "houseLabel",
        "deskSection",
        "fact",
        "snapshot",
        "article"
      ],
      "properties": {
        "id": {
          "enum": [
            "soft-vol",
            "sectors",
            "broad-equity",
            "credit-stress",
            "fund-managers",
            "risk-appetite"
          ]
        },
        "nav": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "house": {
          "enum": [
            "jpm",
            "ms",
            "gs",
            "boa",
            "desk"
          ]
        },
        "houseLabel": {
          "type": "string",
          "minLength": 1
        },
        "deskSection": {
          "type": "string",
          "minLength": 1
        },
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "article": {
          "$ref": "#/$defs/article"
        }
      }
    },
    "snapshot": {
      "description": "A chart frozen at the pack week: weeks through the pack Friday, the headline figures, and the series to redraw. Never a later print.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "weeks",
        "figures",
        "note"
      ],
      "properties": {
        "kind": {
          "enum": [
            "residual",
            "sectors",
            "lines"
          ]
        },
        "weeks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "bars": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/bar"
          }
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "unit",
        "pill",
        "tone"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "pill": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "xsoft",
            "soft",
            "mid",
            "crowded"
          ]
        }
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "short",
        "points",
        "display",
        "tone",
        "bucket",
        "note"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "pattern": "^XL[A-Z0-9]+$"
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "enum": [
            "xsoft",
            "soft",
            "mid",
            "crowded",
            null
          ]
        },
        "bucket": {
          "enum": [
            "extreme soft",
            "soft",
            "mid",
            "crowded",
            null
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "format",
        "guides",
        "series"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "pct",
            "whole",
            "fixed2",
            "percent0",
            "percent1",
            "z"
          ]
        },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "guides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "values"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}

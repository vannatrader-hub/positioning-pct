{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vannatrader-hub.github.io/positioning-pct/data/vault/soft-crowded/schema.json",
  "title": "Soft ↔ Crowded weekly pack",
  "description": "One week of the Vault Soft ↔ Crowded pack: sector buckets on the Soft ↔ Crowded scale, batch-1 chart references, a one-page read, and a short article on each chart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "product", "week", "weekLabel", "house", "houseLabel", "windowWeeks", "basis", "sectorSource", "read", "buckets", "unprinted", "charts"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "sku": { "const": "soft-crowded" },
    "product": { "const": "SKU1" },
    "week": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weekLabel": { "type": "string", "minLength": 1 },
    "house": { "enum": ["jpm", "ms", "gs", "boa", "desk"] },
    "houseLabel": { "type": "string", "minLength": 1 },
    "windowWeeks": { "const": 4 },
    "basis": { "type": "string", "minLength": 1 },
    "sectorSource": { "type": "string", "minLength": 1 },
    "read": { "$ref": "#/$defs/read" },
    "buckets": {
      "description": "Sector buckets on the Soft ↔ Crowded scale, extreme soft through crowded.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/bucket" }
    },
    "unprinted": {
      "type": "array",
      "items": { "$ref": "#/$defs/unprinted" }
    },
    "charts": { "$ref": "#/$defs/chartBatch" }
  },
  "$defs": {
    "read": {
      "description": "One-page read for the week.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "headline", "lede", "stance", "moved", "watch"],
      "properties": {
        "kicker": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "lede": { "type": "string", "minLength": 1 },
        "stance": { "type": "string", "minLength": 1 },
        "moved": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "watch": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "range", "tone", "sectors"],
      "properties": {
        "level": { "enum": ["extreme soft", "soft", "mid", "crowded"] },
        "title": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "tone": { "enum": ["xsoft", "soft", "mid", "crowded"] },
        "sectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/sector" }
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "short", "name", "points", "display", "ile", "pill", "caption", "wowText", "regime", "level"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^XL[A-Z0-9]+$" },
        "short": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "points": { "type": "integer", "minimum": 0, "maximum": 100 },
        "display": { "type": "string", "pattern": "^0\\.\\d{2}$" },
        "ile": { "type": "string", "minLength": 1 },
        "pill": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "wowText": { "type": "string", "minLength": 1 },
        "regime": { "enum": ["Soft", "Mid", "Crowded"] },
        "level": { "enum": ["extreme soft", "soft", "mid", "crowded"] }
      }
    },
    "unprinted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "short", "name", "note"],
      "properties": {
        "ticker": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "article": {
      "description": "Short considered article for one Batch-1 chart. The week read stays the overview. Bank labels only; banned source names fail validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "bodyMarkdown", "bias", "dumbMoney", "smartMoney", "invalidation"],
      "properties": {
        "headline": {
          "description": "At most 12 words, one line.",
          "type": "string",
          "minLength": 1,
          "maxWords": 12,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "bodyMarkdown": {
          "description": "120 to 220 words. Paragraphs separated by a blank line.",
          "type": "string",
          "minLength": 1,
          "minWords": 120,
          "maxWords": 220,
          "x-banned-sources": true
        },
        "bias": { "enum": ["long", "short", "neutral", "fade-long", "fade-short"] },
        "dumbMoney": {
          "description": "One line on the dumb-money cohort: hedge funds, macro funds, mutual funds, CTAs.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "smartMoney": {
          "description": "One line on the smart-money cohort: sharpies, dealers, commercials.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        },
        "invalidation": {
          "description": "One line. The print that kills the bias.",
          "type": "string",
          "minLength": 1,
          "maxWords": 40,
          "pattern": "^[^\\n]+$",
          "x-banned-sources": true
        }
      }
    },
    "chartBatch": {
      "description": "Batch-1 chart references. Each ref points at a Positioning chart and carries that chart's article. The pack does not redraw the chart.",
      "type": "object",
      "additionalProperties": false,
      "required": ["batch", "refs"],
      "properties": {
        "batch": { "const": 1 },
        "refs": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/chartRef" }
        }
      }
    },
    "chartRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nav", "title", "house", "houseLabel", "deskSection", "fact", "article"],
      "properties": {
        "id": { "enum": ["soft-vol", "sectors", "broad-equity", "credit-stress", "fund-managers", "risk-appetite"] },
        "nav": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "house": { "enum": ["jpm", "ms", "gs", "boa", "desk"] },
        "houseLabel": { "type": "string", "minLength": 1 },
        "deskSection": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 },
        "article": { "$ref": "#/$defs/article" }
      }
    }
  }
}

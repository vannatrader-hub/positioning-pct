{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vannatrader-hub.github.io/positioning-pct/data/vault/vol/mag7-oscillator/schema.json",
  "title": "MAG7 oscillator",
  "description": "Vol / breadth wall, beside Spot Vol Beta. Equal-weight seven-name 14-day momentum, smoothed, with signal thresholds and pivot lines. Not charted yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "names", "lookback", "thresholdPct", "pivots", "points"],
  "properties": {
    "sku": { "const": "mag7-oscillator" },
    "names": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "enum": ["AAPL", "MSFT", "GOOGL", "AMZN", "NVDA", "TSLA", "META"] }
    },
    "lookback": { "const": 14 },
    "thresholdPct": { "const": 2, "description": "Signal lines at plus and minus this percent." },
    "pivots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stretched", "caution"],
      "properties": {
        "stretched": { "const": -5, "description": "Stretched long-index pivot." },
        "caution": { "const": 9, "description": "Caution pivot." }
      }
    },
    "points": {
      "type": "array",
      "description": "Append one close per session.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "value", "breadth", "mode", "signal"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "value": { "type": "number" },
          "breadth": { "type": "number", "minimum": 0, "maximum": 100 },
          "mode": { "type": "string", "minLength": 1 },
          "signal": { "type": "string", "minLength": 1 },
          "type": { "type": "string" }
        }
      }
    }
  }
}
